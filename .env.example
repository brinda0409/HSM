# Environment Configuration for Smart Hostel Management System (SHMS)

# Google Gemini API Key (Required for LLM NLU; system gracefully falls back to Heuristic NLP if unprovided)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:password@db.paubhsbghwrmitpyyefs.supabase.co:5432/postgres
DATABASE_PATH=database/hostel.db
